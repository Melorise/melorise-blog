# Public comment deployment repository (OWNER/REPO or HTTPS GitHub URL).
# Optional override of the repository configured in nuxt.config.ts.
# For a static site, supply overrides before generating/deploying the site.
# No administrator token belongs in the site's environment or public config.
NUXT_PUBLIC_COMMENTS0721C_REPOSITORY=Melorise/melorise-blog-comments
NUXT_PUBLIC_COMMENTS0721C_ENABLED=true
NUXT_PUBLIC_COMMENTS0721C_LOCALE=zh-CN
